# Nginx — configuration du site pour Render.
#
# Ce fichier est un gabarit : l'entrypoint remplace __PORT__ par la valeur
# de la variable PORT fournie par Render avant de démarrer Nginx.
#
# Emplacement : /etc/nginx/conf.d/default.conf

server {
    listen __PORT__;
    listen [::]:__PORT__;

    server_name _;

    root /var/www/html/public;
    index index.php;
    charset utf-8;

    # Preuves de paiement et photos : 4 Mo par fichier, plusieurs fichiers
    # par requête. La marge évite un 413 sur les navigateurs anciens.
    client_max_body_size 20m;
    client_body_timeout 120s;

    # Compression des réponses textuelles.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml
        font/woff
        font/woff2;

    # Aucun appel PHP ne doit révéler la pile technique.
    fastcgi_hide_header X-Powered-By;
    add_header X-Powered-By "" always;

    # ------------------------------------------------------------ routage
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Unique point d'entrée PHP autorisé.
    location = /index.php {
        include fastcgi_params;

        fastcgi_pass 127.0.0.1:9000;
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        fastcgi_param DOCUMENT_ROOT $realpath_root;

        fastcgi_read_timeout 120s;
        fastcgi_send_timeout 120s;
        fastcgi_buffer_size 32k;
        fastcgi_buffers 8 32k;
    }

    # Tout autre fichier .php est refusé (uploads malveillants, etc.).
    location ~ \.php$ {
        return 404;
    }

    # Fichiers cachés : .env, .git, .htaccess… ne doivent jamais être servis.
    location ~ /\.(?!well-known) {
        deny all;
    }

    # Assets versionnés par Vite : cache long et immuable.
    location ~* \.(?:css|js|mjs|jpg|jpeg|png|gif|webp|avif|svg|ico|woff|woff2|ttf|map)$ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        access_log off;
        try_files $uri =404;
    }

    # HTML : jamais mis en cache par un proxy, pour que les deployments
    # soient visibles immédiatement.
    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate";
    }
}
